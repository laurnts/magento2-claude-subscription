<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Provider row in Stores > Configuration > Mage-OS > AI Configuration. -->
    <type name="MageOS\AiBase\Model\ServiceRegistry">
        <arguments>
            <argument name="services" xsi:type="array">
                <item name="claude_subscription" xsi:type="object">MagoAssistant\ClaudeSubscription\AiService\ClaudeSubscription</item>
            </argument>
        </arguments>
    </type>
    <!-- Marker so AiBase treats the provider as installed; the plugin below builds the client. -->
    <type name="MageOS\AiBase\Model\Client\BridgeRegistry">
        <arguments>
            <argument name="bridges" xsi:type="array">
                <item name="claude_subscription" xsi:type="array">
                    <item name="factory" xsi:type="string">MagoAssistant\ClaudeSubscription\Service\Bridge\PlatformFactory</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="MageOS\AiBase\Model\Client\ClientFactory">
        <plugin name="magoassistant_claude_subscription_client"
                type="MagoAssistant\ClaudeSubscription\Plugin\ClientFactoryPlugin"
                sortOrder="10"/>
    </type>
    <type name="MagoAssistant\ClaudeSubscription\Service\Client\ClaudeSubscriptionClient">
        <arguments>
            <argument name="proxy" xsi:type="object">MagoAssistant\ClaudeSubscription\Service\Proxy\HttpProxyClient</argument>
        </arguments>
    </type>
</config>
