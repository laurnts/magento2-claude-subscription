{
    "name": "mago-assistant/magento2-claude-subscription",
    "description": "MageOS AiBase provider that chats through a Claude subscription on the Docker host.",
    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "homepage": "https://github.com/laurnts/magento2-claude-subscription",
    "keywords": ["magento", "magento2", "mage-os", "mago", "mago-assistant", "claude", "anthropic", "ai", "assistant"],
    "authors": [
        {
            "name": "Laurentius Judhianto",
            "homepage": "https://github.com/laurnts"
        }
    ],
    "support": {
        "issues": "https://github.com/laurnts/magento2-claude-subscription/issues",
        "source": "https://github.com/laurnts/magento2-claude-subscription"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "mage-os/module-ai-base": "^1.0 || dev-main",
        "magento/framework": "^103.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "MagoAssistant\\ClaudeSubscription\\": ""
        },
        "exclude-from-classmap": ["/Test/"]
    }
}
